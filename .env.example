TZ=Indian/Maldives

# Jev (TypeSafe) — intent, sentiment, language and wellbeing decisions. https://typesafe.ai
TYPESAFE_API_KEY=

# Optional: Claude writes free-form replies in any language (otherwise built-in templates).
ANTHROPIC_API_KEY=
