# Copy to .env and fill in. .env is git-ignored — never commit real keys.

ADMIN_PIN=2468
TZ=Indian/Maldives

# Jev (TypeSafe) — intent, sentiment, language and wellbeing decisions. https://typesafe.ai
TYPESAFE_API_KEY=

# Optional: Claude writes free-form replies in any language (otherwise built-in templates).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5

AIRPORT_NAME=Velana International Airport
WIFI_INFO=network “Airport-Free-WiFi”, no password
# clothing colours that count as uniform, e.g. "navy,white"
UNIFORM_COLORS=
WEEKEND_DAYS=fri,sat
SHIFT_START=08:00
LATE_GRACE_MINUTES=5

# on | staff_only | visitors_only | off   (staff can also opt out individually)
MOOD_TRACKING=on
INTERACTION_RETENTION_DAYS=365

# ---- Live flights: aerodatabox (key from api.market or RapidAPI) | json (your own FIDS feed) | demo | off
# Leave FLIGHT_PROVIDER empty to auto-pick: AeroDataBox if a key is set, else json if a URL is set, else demo.
FLIGHT_PROVIDER=
FLIGHT_AIRPORT=MLE
AERODATABOX_KEY=
AERODATABOX_RAPIDAPI_KEY=
FLIGHT_FEED_URL=
FLIGHT_REFRESH_SECONDS=180

# ---- Assistance requests
# PIN for service-desk agents on /assist (defaults to ADMIN_PIN)
ASSIST_PIN=
# optional: POST {"text": ..., "request": {...}} to Slack/Teams/WhatsApp-gateway on every new request
ASSIST_WEBHOOK_URL=
ASSIST_SLA_MINUTES=5

# ---- Ramp safety pack
# where flagged safety checks (missing PPE / high fatigue) are posted; defaults to ASSIST_WEBHOOK_URL
SAFETY_WEBHOOK_URL=
HIVIS_MIN_SHARE=0.12

# ---- Roster + supervisor alerts
ALERT_WEBHOOK_URL=
ALERT_SCAN_SECONDS=60
NO_SHOW_MINUTES=15
LATE_ALERT_MINUTES=10
CLOCKOUT_GRACE_MINUTES=60
BREAK_MAX_MINUTES=60
UNDERSTAFF_MIN=2
EARLY_LEAVE_MINUTES=15
